# Generated by node scripts/versions.mjs sync; edit scripts/Dockerfile.template.
FROM {{nodeImage}} AS node-runtime

FROM {{playwrightImage}} AS runtime

LABEL org.opencontainers.image.title="OneCX Playwright runtime" \
      org.opencontainers.image.description="Shared browser runtime; application lockfiles own test dependencies and authentication fixtures" \
      org.opencontainers.image.version="{{release}}" \
      org.onecx.playwright.contract="1"

COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=node-runtime /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm

RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && test "$(node --version)" = "v{{node}}" \
    && npm --version

ENV CI=true \
    TEST_ROOT=/app/integration \
    OUTPUT_DIR=/e2e-results \
    ONECX_PLAYWRIGHT_VERSION={{playwright}}

WORKDIR /app/integration

COPY runtime/ /opt/onecx-playwright/
RUN sh -n /opt/onecx-playwright/entrypoint.sh \
    && chmod 755 /opt/onecx-playwright/entrypoint.sh

ENTRYPOINT ["/opt/onecx-playwright/entrypoint.sh"]
CMD ["tests:gui"]

FROM runtime AS orchestrator
LABEL org.opencontainers.image.title="OneCX integration orchestrator" \
      org.opencontainers.image.description="Shared integration CLI, Docker client and Java; no application tests" \
      org.opencontainers.image.version="{{release}}-orchestrator" \
      org.onecx.playwright.contract="" \
      org.onecx.orchestrator.contract="1"

RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/onecx-orchestrator
COPY orchestrator/package.json orchestrator/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund \
    && node -e 'const p=require("./package.json"); for(const [name,version] of Object.entries(p.dependencies)) { if(require("./node_modules/"+name+"/package.json").version!==version) throw new Error("Installed version mismatch: "+name) }'
COPY orchestrator/runner/ ./runner/
COPY orchestrator/compatibility/ ./compatibility/
RUN set -eu; for adapter in compatibility/patch-*.mjs; do node "$adapter"; done
COPY orchestrator/workflow-launch.sh ./
RUN sh -n workflow-launch.sh && chmod 755 workflow-launch.sh
WORKDIR /work
ENTRYPOINT ["node", "/opt/onecx-orchestrator/runner/index.mjs"]
CMD ["--help"]

# Keep an unqualified docker build backwards-compatible with the runtime.
FROM runtime AS default-runtime
